<Window x:Class="ParamonovDesktop.View.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParamonovDesktop.View"
        mc:Ignorable="d"
        Title="Сообщение" Height="210" Width="210" Background="BlanchedAlmond" FontFamily="Consolas" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="ОТМЕНА" IsCancel="True" Click="CancelButton_Click" Width="70" Margin="0,0,8,0" Background="BlanchedAlmond" FontWeight="Bold"/>
                <Button Content="OK" IsDefault="True" Click="OkButton_Click" Width="70" Background="RoyalBlue" FontWeight="Bold" Foreground="BlanchedAlmond"/>
               
            </StackPanel>
        </Grid>
    </Grid>
</Window>

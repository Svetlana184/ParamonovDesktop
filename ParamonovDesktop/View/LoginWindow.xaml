<Window x:Class="ParamonovDesktop.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParamonovDesktop.View"
        mc:Ignorable="d"
        Title="Вход" Height="500" Width="400" Background="LightBlue" FontFamily="Consolas">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="30"
                   HorizontalAlignment="Center" Margin="0 0 0 20" FontWeight="ExtraBold"/>

        <Label Grid.Row="1" Content="Логин" FontSize="20"/>
        <TextBox FontSize="20" Grid.Row="2" Margin="0 5 0 10"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Background="BlanchedAlmond"/>

        <Label Grid.Row="3" Content="Пароль" FontSize="20"/>
        <PasswordBox FontSize="20" Grid.Row="4" x:Name="PwdBox" Margin="0 5 0 10"
                     PasswordChanged="PwdBox_OnPasswordChanged" Background="BlanchedAlmond"/>

        <StackPanel Grid.Row="5" Orientation="Vertical">
            <Button Content="ВОЙТИ" Command="{Binding AuthCommand}"
                    Height="35" Margin="0 10" FontSize="20" Background="RoyalBlue" FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Нет аккаунта?" Margin="0 15" FontSize="20"/>
                <Button Command="{Binding OpenRegisterCommand}"
                    Height="30" Margin="0 10" FontSize="20" Background="LightBlue" BorderBrush="LightBlue">
                    <Button.Content>
                        <TextBlock Text="Регистрация" FontWeight="Bold" Foreground="RoyalBlue"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </StackPanel>
        <Image Grid.Row="6" Source="/Resources/paramonov_ui_cat.png" Width="150" Height="100"/>
    </Grid>
</Window>

<Window x:Class="ParamonovDesktop.View.ProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParamonovDesktop.View"
        mc:Ignorable="d"
        Title="Карточка проекта" Height="700" Width="900"  FontFamily="Consolas" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/paramonov_ui_bg.jpg" 
                Stretch="UniformToFill"/>
    </Window.Background>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- === Шапка === -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 0 0 5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Проект: " FontSize="22" FontWeight="Bold"/>
                <TextBox Text="{Binding Project.Name}" FontSize="22" FontWeight="Bold"
                         IsEnabled="{Binding CanEditProjectHeader}" Width="260"/>
                <TextBlock Text=" — " FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding Project.StatusText}" FontSize="22" FontWeight="Bold"
                           Foreground="RoyalBlue"/>
            </StackPanel>
            <TextBlock Text="{Binding TotalCostText}" FontSize="16" FontWeight="Bold"
                       Foreground="DarkRed" Margin="0 5 0 0"/>
        </StackPanel>

        <!-- === Заказчик / команда === -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0 0 0 10">
            <TextBlock Text="{Binding CustomerInfo}" FontSize="14"/>
            <TextBlock Text="{Binding TeamInfo}" FontSize="14"/>
        </StackPanel>

        <!-- === Основная область === -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ТЗ -->
            <GroupBox Grid.Column="0" Header="Техническое задание" FontSize="16"
                      Margin="0 0 5 0" IsEnabled="{Binding CanEditSpec}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Project.Description}"
                               TextWrapping="Wrap" Margin="5"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SpecItems}"
                             SelectedItem="{Binding SelectedSpecItem}" Margin="5"
                             Background="BlanchedAlmond">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3">
                                    <TextBox Text="{Binding Name}" FontWeight="Bold"
                                             BorderThickness="0" Background="Transparent"/>
                                    <TextBox Text="{Binding Description}" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить пункт" Command="{Binding AddSpecItemCommand}"
                                Width="130" Margin="0 0 5 0" Background="BlanchedAlmond"/>
                        <Button Content="Удалить пункт" Command="{Binding DeleteSpecItemCommand}"
                                Width="130" Background="BlanchedAlmond"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Счёт и задачи -->
            <GroupBox Grid.Column="1" Header="Счёт и задачи" FontSize="16" Margin="5 0 0 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Название счёта и итог -->
                    <Grid Grid.Row="0" Margin="5" IsEnabled="{Binding CanEditInvoice}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Счёт:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Invoice.Name}" Margin="5 0"
                                 Background="BlanchedAlmond"/>
                        <TextBlock Grid.Column="2" Text="Итого:" VerticalAlignment="Center" Margin="10 0 0 0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Invoice.TotalCost, StringFormat={}{0:N2} ₽}"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="5 0"/>
                    </Grid>

                    <!-- Даты -->
                    <Grid Grid.Row="1" Margin="5" IsEnabled="{Binding CanEditInvoice}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Начало:" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding Invoice.StartDate}" Margin="5 0"/>
                        <TextBlock Grid.Column="2" Text="Конец:" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding Invoice.EndDate}" Margin="5 0"/>
                    </Grid>

                    <!-- Задачи -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Margin="5" Background="BlanchedAlmond"
                              IsReadOnly="{Binding CanManageTasks, Converter={StaticResource InverseBool}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="План, ч" Binding="{Binding PlannedHours}" Width="70"/>
                            <DataGridTextColumn Header="Факт, ч" Binding="{Binding ActualHours}" Width="70"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Кнопки задач -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить задачу" Command="{Binding AddTaskCommand}"
                                Width="140" Margin="0 0 5 0" Background="BlanchedAlmond"
                                Visibility="{Binding CanManageTasks, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="Удалить задачу" Command="{Binding DeleteTaskCommand}"
                                Width="140" Background="BlanchedAlmond"
                                Visibility="{Binding CanManageTasks, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- === Кнопки действий === -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="СОХРАНИТЬ И ОТПРАВИТЬ"
                    Command="{Binding SaveProjectAndSubmitCommand}"  IsEnabled="{Binding CanEditProjectHeader}"
                    Visibility="{Binding CanEditProjectHeader, Converter={StaticResource BoolToVisibility}}"
                    Width="220" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="СОХРАНИТЬ СЧЁТ"
                    Command="{Binding SaveInvoiceCommand}" IsEnabled="{Binding CanEditInvoice}"
                    Visibility="{Binding CanEditInvoice, Converter={StaticResource BoolToVisibility}}"
                    Width="180" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="СОХРАНИТЬ ЧАСЫ"
                    Command="{Binding SaveHoursCommand}" IsEnabled="{Binding CanEditHours}"
                    Visibility="{Binding CanEditHours, Converter={StaticResource BoolToVisibility}}"
                    Width="180" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="ОТПРАВИТЬ"
                    Command="{Binding SendInvoiceCommand}" IsEnabled="{Binding CanSendInvoice}"
                    Visibility="{Binding CanSendInvoice, Converter={StaticResource BoolToVisibility}}"
                    Width="140" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="ПРИНЯТЬ" Command="{Binding ApproveChangeCommand}" IsEnabled="{Binding CanApproveChanges}"
                    Visibility="{Binding CanApproveChanges, Converter={StaticResource BoolToVisibility}}"
                    Width="120" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="ОТКЛОНИТЬ" Command="{Binding RejectChangeCommand}" IsEnabled="{Binding CanApproveChanges}"
                    Visibility="{Binding CanApproveChanges, Converter={StaticResource BoolToVisibility}}"
                    Width="120" Height="30" Margin="5" Background="BlanchedAlmond"
                    FontWeight="Bold"/>
            <Button Content="СОХРАНИТЬ ИЗМЕНЕНИЯ"
                    Command="{Binding FinishApprovalCommand}" IsEnabled="{Binding CanFinishApproval}"
                    Visibility="{Binding CanFinishApproval, Converter={StaticResource BoolToVisibility}}"
                    Width="220" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="ЗАМОРОЗИТЬ" Command="{Binding FreezeProjectCommand}" IsEnabled="{Binding CanFreeze}"
                    Visibility="{Binding CanFreeze, Converter={StaticResource BoolToVisibility}}"
                    Width="140" Height="30" Margin="5" Background="BlanchedAlmond"
                    FontWeight="Bold"/>
            <Button Content="РАЗМОРОЗИТЬ" Command="{Binding UnfreezeProjectCommand}" IsEnabled="{Binding CanUnfreeze}"
                    Visibility="{Binding CanUnfreeze, Converter={StaticResource BoolToVisibility}}"
                    Width="140" Height="30" Margin="5" Background="RoyalBlue"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="ЗАКРЫТЬ ПРОЕКТ" Command="{Binding CloseProjectCommand}" IsEnabled="{Binding CanCloseProject}"
                    Visibility="{Binding CanCloseProject, Converter={StaticResource BoolToVisibility}}"
                    Width="160" Height="30" Margin="5" Background="DarkRed"
                    FontWeight="Bold" Foreground="BlanchedAlmond"/>
        </WrapPanel>

        <!-- === Запросы на изменения === -->
        <GroupBox Grid.Row="4" Header="Запросы на изменения" FontSize="16" Margin="0 10 0 0"
                  Visibility="{Binding IsPendingInvoiceApproval, Converter={StaticResource BoolToVisibility}}">
            <ListBox ItemsSource="{Binding ChangeRequests}"
                     SelectedItem="{Binding SelectedChange}" Background="BlanchedAlmond">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="3">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0 0 10 0"/>
                            <TextBlock Text="{Binding Description}" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>

<Window x:Class="ParamonovDesktop.View.ProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParamonovDesktop.View"
        mc:Ignorable="d"
        Title="Карточка проекта" Height="700" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" Margin="0 0 0 10">
            <Run Text="Проект: "/>
            <Run Text="{Binding Project.Name}"/>
        </TextBlock>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Техническое задание" Margin="0 0 5 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Project.Description}"
                               TextWrapping="Wrap" Margin="5"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SpecItems}"
                             SelectedItem="{Binding SelectedSpecItem}" Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="Сохранить и отправить менеджеру"
                            Command="{Binding SaveSpecAndSendCommand}"
                            IsEnabled="{Binding CanEditSpec}" Margin="5"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Счет и задачи" Margin="5 0 0 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False" CanUserAddRows="False" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="План, ч" Binding="{Binding PlannedHours}" Width="70"/>
                            <DataGridTextColumn Header="Факт, ч" Binding="{Binding ActualHours}" Width="70"
                                                IsReadOnly="{Binding DataContext.CanEditHours, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost}" Width="100"
                                                IsReadOnly="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="5">
                        <Button Content="Сохранить часы" Command="{Binding SaveHoursCommand}"
                                IsEnabled="{Binding CanEditHours}" Width="130" Margin="0 0 5 0"/>
                        <Button Content="Сохранить и отправить" Command="{Binding SaveTaskAndSendCommand}"
                                IsEnabled="{Binding CanEditTasks}" Width="160"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Запросы на изменения" Margin="0 10 0 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding ChangeRequests}"
                         SelectedItem="{Binding SelectedChange}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="3">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0 0 10 0"/>
                                <TextBlock Text="{Binding Description}" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="5">
                    <Button Content="Принять" Command="{Binding ApproveChangeCommand}"
                            IsEnabled="{Binding CanApproveChanges}" Width="100" Margin="0 0 5 0"/>
                    <Button Content="Отклонить" Command="{Binding RejectChangeCommand}"
                            IsEnabled="{Binding CanApproveChanges}" Width="100"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>

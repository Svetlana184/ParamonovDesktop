<Window x:Class="ParamonovDesktop.View.ProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParamonovDesktop.View"
        mc:Ignorable="d"
        Title="Карточка проекта" Height="700" Width="900"  FontFamily="Consolas" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/paramonov_ui_bg.jpg" 
                Stretch="UniformToFill"/>
    </Window.Background>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel  Grid.Row="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Grid.Row="0"  Margin="0 0 0 5">
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding HeaderTextEditable}">
                    <TextBlock Text="Проект: " FontSize="22" FontWeight="Bold"/>
                    <TextBox Text="{Binding Project.Name}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text=" — " FontSize="22" FontWeight="Bold"/>
                    <TextBox Text="{Binding Project.StatusText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Назначение команды" FontSize="16" Visibility="{Binding HeaderSelectTeamVisibility}" IsEnabled="{Binding HeaderSelectTeamEditable}">
                        <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}"
                                DisplayMemberPath="Name" Width="200" HorizontalAlignment="Left"/>
                    </GroupBox>
                    <StackPanel Orientation="Vertical" Margin="0 0 0 10" Visibility="{Binding HeaderSelectTeamVisibility}">
                        <TextBlock Text="{Binding CustomerInfo}" FontSize="14"/>
                        <TextBlock Text="{Binding TeamInfo}" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: ТЗ -->
            <GroupBox Grid.Column="0" Header="Техническое задание" Margin="0 0 5 0" FontSize="16" IsEnabled="{Binding TechnicalSpecificationEditable}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Project.Description}"
                               TextWrapping="Wrap" Margin="5"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SpecItems}"
                             SelectedItem="{Binding SelectedSpecItem}" Margin="5"
                             Background="BlanchedAlmond">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"

                                Margin="5">
                        <Button Content="Добавить" Command="{Binding AddSpecItemCommand}"
                                Width="100" Margin="0 0 5 0"/>
                        <Button Content="Удалить" Command="{Binding DeleteSpecItemCommand}"
                                Width="100" Margin="0 0 5 0"/>
                        <Button Content="Сохранить" Command="{Binding SaveSpecItemCommand}"
                                Width="100"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Правая часть: счёт и задачи -->
            <GroupBox Grid.Column="2" Header="Счёт и задачи" Margin="5 0 0 0" FontSize="16" IsEnabled="{Binding InvoiceEditable}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TaskGrid"
                              Grid.Row="0" ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Margin="5" Background="BlanchedAlmond">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"
                                />

                            <DataGridTextColumn Header="План, ч" Binding="{Binding PlannedHours}" Width="70"
                                />

                            <DataGridTextColumn Header="Факт, ч" Binding="{Binding ActualHours}" Width="70"
                                />

                            <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost}" Width="100"
                                />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Кнопки управления задачами: manager/developer в in_progress -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5"
                                >
                        <Button Content="Добавить задачу" Command="{Binding AddTaskCommand}"
                                Width="130" Margin="0 0 5 0"/>
                        <Button Content="Удалить задачу" Command="{Binding DeleteTaskCommand}"
                                Width="130" Margin="0 0 5 0"/>
                        <Button Content="Сохранить задачу" Command="{Binding SaveTaskCommand}"
                                Width="140"/>
                    </StackPanel>

                    <!-- Кнопка «Сохранить часы»: developer в pending_approval -->
                    <Button Grid.Row="1" Content="Сохранить часы"
                            Command="{Binding SaveHoursCommand}"
                            
                            HorizontalAlignment="Right" Margin="5"
                            Width="140" Background="BlanchedAlmond" FontWeight="Bold"/>

                    <Button Grid.Row="2" Content="Отправить счёт на проверку"
                            Command="{Binding SendInvoiceForReviewCommand}"
                            
                            Margin="5" Background="RoyalBlue" FontWeight="Bold"
                            Foreground="BlanchedAlmond" Height="30"/>
                </Grid>
            </GroupBox>
        </Grid>


        <!-- Нижняя панель --> 
        <Grid Grid.Row="2" Margin="0 10 0 0" Visibility="{Binding ChangeRequestsVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Запросы на изменения" FontSize="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding ChangeRequests}"
                             SelectedItem="{Binding SelectedChange}" Background="BlanchedAlmond">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="5"
                                >
                        <Button Content="ОТКЛОНИТЬ" Command="{Binding RejectChangeCommand}"
                                Width="120" Margin="0 0 10 0" Background="BlanchedAlmond"
                                FontSize="18" FontWeight="Bold"/>
                        <Button Content="ПРИНЯТЬ" Command="{Binding ApproveChangeCommand}"
                                Width="100" Background="RoyalBlue" FontSize="18"
                                FontWeight="Bold" Foreground="BlanchedAlmond"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="СОХРАНИТЬ ИЗМЕНЕНИЯ"
                Command="{Binding FinishApprovalCommand}"
        
                Height="30" Width="150" Margin="10" Background="RoyalBlue"
                FontWeight="Bold" Foreground="BlanchedAlmond"/>
            <Button Content="ОТПРАВИТЬ ИЗМЕНЕНИЯ"
                Command="{Binding FinishApprovalCommand}"
        
                Height="30" Width="150" Margin="10" Background="RoyalBlue"
                FontWeight="Bold" Foreground="BlanchedAlmond"/>

            <Button Content="ЗАМОРОЗИТЬ"
                Command="{Binding FreezeProjectCommand}"
        
                Height="30" Width="150" Margin="10"  Background="BlanchedAlmond"
                FontWeight="Bold" Visibility="{Binding RefrozeButtonVisibility}"/>

            <Button Content="РАЗМОРОЗИТЬ" 
        Command="{Binding UnfreezeProjectCommand}"
        
        Height="30" Width="150" Margin="10" Background="RoyalBlue"
        FontWeight="Bold" Foreground="BlanchedAlmond"/>

            <Button Content="ЗАКРЫТЬ ПРОЕКТ"
        Command="{Binding CloseProjectCommand}"
        
        Height="30" Background="DarkRed"
        FontWeight="Bold" Width="150" Margin="10" Foreground="BlanchedAlmond"/>
        </StackPanel>
    </Grid>
</Window>

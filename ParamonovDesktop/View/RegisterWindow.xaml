<Window x:Class="ParamonovDesktop.View.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParamonovDesktop.View"
        mc:Ignorable="d"
        Title="Регистрация" Height="600" Width="400">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регистрация" FontSize="24"
                   HorizontalAlignment="Center" Margin="0 0 0 15"/>

        <Label Grid.Row="1" Content="Имя *"/>
        <TextBox Grid.Row="2" Margin="0 0 0 8"
                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="3" Content="Фамилия *"/>
        <TextBox Grid.Row="4" Margin="0 0 0 8"
                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="5" Content="Логин *"/>
        <TextBox Grid.Row="6" Margin="0 0 0 8"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="7" Content="Пароль *"/>
        <PasswordBox Grid.Row="8" Margin="0 0 0 8"
                     PasswordChanged="PasswordBox_OnPasswordChanged"/>

        <Label Grid.Row="9" Content="Повторите пароль *"/>
        <PasswordBox Grid.Row="10" Margin="0 0 0 8"
                     PasswordChanged="PasswordConfirmBox_OnPasswordChanged"/>

        <StackPanel Grid.Row="11">
            <Label Content="Роль *"/>
            <ComboBox SelectedIndex="{Binding SelectedRoleIndex}">
                <ComboBoxItem Content="Заказчик"/>
                <ComboBoxItem Content="Менеджер"/>
                <ComboBoxItem Content="Разработчик"/>
            </ComboBox>

            <Label Content="ID компании (необязательно)" Margin="0 8 0 0"/>
            <TextBox Text="{Binding IdCompanyText, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="ID команды (необязательно)" Margin="0 8 0 0"/>
            <TextBox Text="{Binding IdTeamText, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 15 0 0">
                <Button Content="Назад" Command="{Binding BackToLoginCommand}"
                        Width="100" Height="32" Margin="0 0 10 0"/>
                <Button Content="Зарегистрироваться"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Width="160" Height="32"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
